{
  "name": "marlon-app",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Marlon: delivery invoices on any phone (the sellable copy). Each business sets itself up; its data stays on its own phone.",
  "scripts": {
    "dev": "npm run build && ../chief-of-staff/node_modules/.bin/wrangler dev --port 8794",
    "deploy": "npm run build && ../chief-of-staff/node_modules/.bin/wrangler deploy",
    "test": "node tests/run-all.cjs",
    "stamp": "node scripts/stamp-sw.cjs",
    "startup-images": "node scripts/make-startup-images.cjs",
    "build": "node scripts/stamp-sw.cjs && node scripts/build-worker.cjs"
  },
  "devDependencies": {
    "@fontsource/bodoni-moda": "^5.3.0",
    "jsqr": "1.4.0",
    "opentype.js": "^1.3.4"
  }
}
