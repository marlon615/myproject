# ─────────────────────────────────────────────────────────────
# Future Self environment variables
# Local: copy to .env.local   ·   Vercel: Project → Settings → Environment Variables
# All of these stay on the server. None of them are ever sent to the phone.
# ─────────────────────────────────────────────────────────────

# Your Anthropic API key (console.anthropic.com → API Keys). Powers future-self replies.
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the replies. Default: claude-opus-5-5
# FUTURE_SELF_MODEL=claude-opus-5-5

# Random string, 32+ characters. Signs the login cookies. Generate with:  openssl rand -base64 32
SESSION_SECRET=

# Password for YOUR private owner dashboard at /owner (12+ characters). Only you should know it.
OWNER_PASSWORD=

# Postgres connection string (Neon, Supabase, Vercel Postgres...). Use the POOLED url on Vercel.
# Needed for the owner dashboard numbers and the daily chat limit. Tables are created automatically.
DATABASE_URL=

# Optional: max AI replies per person per day (protects your API bill). Default 60.
# DAILY_CHAT_LIMIT=60

# Optional: time zone for "today" on the owner dashboard. Default America/Chicago (US Central).
# APP_TIMEZONE=America/Chicago
