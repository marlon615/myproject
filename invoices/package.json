{
  "name": "marlon-invoices",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Offline delivery invoices for Marlon Williams: a phone-installable web app.",
  "scripts": {
    "dev": "npm run build && ../chief-of-staff/node_modules/.bin/wrangler dev --port 8790",
