# ─────────────────────────────────────────────────────────────
# ChurchFollow environment variables
# Local: copy to .env.local   ·   Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Postgres connection string (Neon, Supabase, Vercel Postgres, etc.). Use the POOLED url on Vercel.
DATABASE_URL=postgres://user:password@host:5432/churchfollow

# Random string, 32+ characters. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Password for YOUR private owner dashboard at /admin (8+ characters).
ADMIN_PASSWORD=

# Public URL of the app (used in QR codes and texts). Set this to your real domain in production.
APP_URL=https://churchfollow.example.com

# Protects /api/cron/send. Vercel Cron sends it automatically. Generate with: openssl rand -hex 24
CRON_SECRET=

# ── Texting ─────────────────────────────────────────────────
# "console" logs texts to the server log (for testing). "twilio" sends real texts.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a phone number you own in Twilio...
TWILIO_FROM_NUMBER=
# ...or a Messaging Service (recommended for A2P 10DLC). If set, it's used instead of the number.
TWILIO_MESSAGING_SERVICE_SID=

# ── Billing (Stripe) ────────────────────────────────────────
STRIPE_SECRET_KEY=
# A recurring $39/month Price created in the Stripe dashboard.
STRIPE_PRICE_ID=
# Signing secret for the webhook endpoint https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
