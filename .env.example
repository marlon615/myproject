# ─────────────────────────────────────────────────────────────
# CallCairn environment variables
# Local: copy to .env.local   ·   Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Postgres connection string (Neon, Supabase, etc.). Use the POOLED url on Vercel.
DATABASE_URL=postgres://user:password@host:5432/callcairn

# Random string, 32+ characters. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Password for the private owner dashboard at /admin (12+ characters).
# Sign-in also requires the owner email, foliopayments.ja@gmail.com (set in src/lib/config.ts).
ADMIN_PASSWORD=

# Public URL of the app. Twilio webhooks and the calendar link use it.
APP_URL=https://callcairn.example.com

# CallCairn's own US sales/demo line shown on the landing page (E.164). Default is a fictional 555 number.
PUBLIC_PHONE_NUMBER=

# Optional: time zone for the owner dashboard. Default America/Chicago (US Central).
# APP_TIMEZONE=America/Chicago

# Protects /api/cron/reminders. Vercel Cron sends it automatically. Generate with: openssl rand -hex 24
CRON_SECRET=

# ── AI (Claude) ─────────────────────────────────────────────
# Reads and classifies what callers say. Without it, a keyword fallback is used.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Phone + texting (Twilio) ────────────────────────────────
# "console" logs texts to the server log (for testing). "twilio" sends real texts.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Messaging Service registered for A2P 10DLC (recommended). New CallCairn numbers are added to it.
TWILIO_MESSAGING_SERVICE_SID=
# Optional fallback sender if a contractor has no number of their own.
TWILIO_FROM_NUMBER=
# Optional voice for the assistant (Amazon Polly via Twilio). Default Polly.Joanna-Neural.
# TWILIO_VOICE=Polly.Joanna-Neural

# ── Billing (PayPal Subscriptions, US dollars) ──────────────
# "sandbox" for testing with fake money, "live" for real payments.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Both printed by:  npm run paypal:setup
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
